{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend (Django API)",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe manage.py runserver 127.0.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "2. Run Frontend (React Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      }
    },
    {
      "label": "Start Fullstack (Django + React)",
      "dependsOn": [
        "1. Run Backend (Django API)",
        "2. Run Frontend (React Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
